{
  "name": "DH Trails",
  "short_name": "DH Trails",
  "description": "Time trial y entrenamiento de descenso en los circuitos de tu zona.",
  "lang": "es",
  "id": "./index.html",
  "start_url": "./tablon.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#071423",
  "theme_color": "#071423",
  "icons": [
    {"src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "file",
        "accept": [".gpx", ".tcx", ".fit", "application/gpx+xml", "application/vnd.ant.fit", "application/vnd.garmin.tcx+xml", "application/xml", "text/xml", "application/octet-stream"]
      }]
    }
  }
}
