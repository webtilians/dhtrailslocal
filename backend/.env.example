# Duplicate as backend/.env. DEVELOPMENT ONLY; never commit real credentials.
DATABASE_URL=postgresql+psycopg://dhtrails:dhtrails_local_only@127.0.0.1:5432/dhtrails
# Set this using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# When deploying: restrict origins to your actual HTTPS frontend domain
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://webtilians.github.io
GPS_STORAGE_DIR=./data/activities
